# Vita Environment Variables — copy this file to .env and fill in real values
# ─────────────────────────────────────────────────────────────────────────────

# JWT signing secret (REQUIRED) — generate with: openssl rand -hex 32
JWT_SECRET_KEY=

# Postgres password (must match POSTGRES_PASSWORD in docker-compose.yml)
POSTGRES_PASSWORD=

# Gemini API key — get a free key at: https://aistudio.google.com/apikey
# Without this, unknown apps fall back to local TF-IDF classifier.
GEMINI_API_KEY=

# Set to "production" to disable interactive /docs and /redoc pages
APP_ENV=development
